<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Master Binder Hub</title>
    <!-- iOS Cross-Platform PWA Side-Loading Metadata Hooks -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="MB Hub">
    
    <style>
        /* --- CORE VISUAL DESIGN ACCOMMODATIONS --- */
        :root {
            --denim-bg: #111827;        /* Glare-Absorbing Dark Indigo Core */
            --slate-panel: #1f2937;    /* Low-Saturation Lightened Slate Blue Panel */
            --text-main: #f9fafb;       /* High-Contrast Clear Text Layer */
            --rainbow-border: #374151;  /* Muted Accent Guides */
            --rainbow-red: #dc2626;     /* Soft Deep Rainbow Grids */
            --rainbow-yellow: #d97706;
            --rainbow-green: #059669;
            --rainbow-blue: #2563eb;
        }

        /* Fluid Layout Grid Scales Automatically for Mobile, Tablet, and PC Desktop Formats */
        body {
            background-color: var(--denim-bg);
            color: var(--text-main);
            font-family: system-ui, -apple-system, sans-serif;
            margin: 0;
            padding: 12px;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
            box-sizing: border-box;
        }

        .app-container {
            width: 100%;
            max-width: 1200px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        /* --- THE PERMANENT FIXED OMNI CORES --- */
        .omni-panel {
            background-color: var(--slate-panel);
            border: 3px solid var(--rainbow-blue);
            border-radius: 12px;
            padding: 14px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.4);
        }

        .omni-header {
            font-size: 1.1rem;
            font-weight: bold;
            margin-bottom: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        /* Massive Pill Button Grid Optimization for Touchscreens & Low-Vision Needs */
        .pill-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-bottom: 12px;
        }

        .action-pill {
            background-color: #374151;
            border: 2px solid transparent;
            color: white;
            padding: 12px 18px;
            border-radius: 24px;
            font-weight: bold;
            cursor: pointer;
            font-size: 0.9rem;
            transition: all 0.15s ease-in-out;
        }

        .action-pill:active {
            transform: scale(0.96);
            background-color: var(--rainbow-green);
        }

        /* --- 20-CHAPTER DIRECT BOOK NAVIGATION VAULT --- */
        .chapter-dock {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 4px;
            background: #030712;
            padding: 8px;
            border-radius: 8px;
        }

        .chapter-key {
            background: var(--slate-panel);
            border: 1px solid var(--rainbow-border);
            border-radius: 6px;
            padding: 8px 4px;
            text-align: center;
            cursor: pointer;
            font-weight: bold;
            font-size: 0.85rem;
        }

        /* --- THE INTUITIVE QUICK CAPTURE SLATE --- */
        .capture-slate {
            background-color: var(--slate-panel);
            border-radius: 12px;
            padding: 14px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            border: 2px solid var(--rainbow-border);
        }

        .slate-input {
            width: 100%;
            height: 90px;
            background-color: #030712;
            border: 2px solid var(--rainbow-border);
            border-radius: 8px;
            color: white;
            padding: 10px;
            box-sizing: border-box;
            font-size: 1rem;
            resize: none;
        }

        /* --- ADMIN SWITCHBOARD ACCESS MATRIX --- */
        .admin-box {
            background-color: #030712;
            border: 2px solid var(--rainbow-red);
            border-radius: 12px;
            padding: 12px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        /* --- STABLE VIEW CARDS --- */
        .workspace-view {
            width: 100%;
            min-height: 180px;
            border: 2px dashed var(--rainbow-border);
            border-radius: 12px;
            padding: 14px;
            box-sizing: border-box;
            overflow-y: auto; /* Continuous Vertical Scroll Default */
        }

        .footer-note {
            font-size: 0.75rem;
            color: #9ca3af;
            border-top: 1px solid var(--rainbow-border);
            padding-top: 8px;
            margin-top: 12px;
        }
    </style>
</head>
